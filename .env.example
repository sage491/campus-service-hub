# Backend
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/campus-service-hub
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional first administrator, created once after MongoDB connects
ADMIN_NAME=Campus Administrator
ADMIN_EMAIL=admin@campus.edu
ADMIN_PASSWORD=replace-with-a-strong-password

# Frontend (optional when using the Vite development proxy)
VITE_API_URL=http://localhost:5000/api
